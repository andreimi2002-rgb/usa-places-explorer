---
/**
 * A simplified uniform diagram (jersey + shorts) drawn from the kit data.
 * It shows only what the data records: base color, optional shoulder panel,
 * trim stripes, pinstripes and wordmark. It is our own drawing, not the real design.
 */
interface Props {
  kit: {
    edition: string;
    season: string;
    base: string;
    panel?: string;
    trim?: string;
    pinstripes: boolean;
    wordmark?: string;
    maker?: string;
    description: string;
  };
  uid: string;
}
const { kit, uid } = Astro.props;

/** Relative luminance, to pick readable contrast colors. */
function luminance(hex: string) {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}
const light = luminance(kit.base) > 0.5;
const ink = light ? '#1b2333' : '#ffffff';
const stripe = kit.trim ?? (light ? 'rgba(27,35,51,0.35)' : 'rgba(255,255,255,0.45)');
const outline = light ? 'rgba(27,35,51,0.35)' : 'rgba(255,255,255,0.22)';

const jersey = 'M38 6 Q60 26 82 6 L96 10 Q98 34 116 46 L114 150 L6 150 L4 46 Q22 34 24 10 Z';
const shorts = 'M8 160 L112 160 L118 226 L68 226 L60 196 L52 226 L2 226 Z';
const labels: Record<string, string> = {
  association: 'Association',
  icon: 'Icon',
  statement: 'Statement',
  city: 'City',
  classic: 'Classic',
  home: 'Home',
  away: 'Away',
  third: 'Third',
  alternate: 'Alternate',
};
const pins = Array.from({ length: 15 }, (_, i) => 6 + i * 8);
---

<figure class="kit">
  <svg viewBox="0 0 120 230" role="img" aria-label={`${labels[kit.edition]} uniform, ${kit.season}: ${kit.description}`}>
    <defs>
      <clipPath id={`j-${uid}`}><path d={jersey} /></clipPath>
      <clipPath id={`s-${uid}`}><path d={shorts} /></clipPath>
    </defs>
    <g clip-path={`url(#j-${uid})`}>
      <rect width="120" height="160" fill={kit.base} />
      {kit.pinstripes && pins.map((x) => <line x1={x} y1="0" x2={x} y2="160" stroke={stripe} stroke-width="0.9" />)}
      {kit.panel && <path d="M0 0 H120 V48 Q60 60 0 48 Z" fill={kit.panel} />}
      {kit.trim && kit.panel && (
        <>
          <rect x="0" y="52" width="120" height="2.5" fill={kit.trim} />
          <rect x="0" y="80" width="120" height="2.5" fill={kit.trim} />
        </>
      )}
    </g>
    <path d={jersey} fill="none" stroke={kit.trim ?? outline} stroke-width="2" />
    {kit.wordmark && (
      <text x="60" y="73" text-anchor="middle" fill={ink} font-family="var(--font-display)" font-weight="700" font-size="17" letter-spacing="1">
        {kit.wordmark}
      </text>
    )}
    <g clip-path={`url(#s-${uid})`}>
      <rect y="160" width="120" height="70" fill={kit.base} />
      {kit.pinstripes && pins.map((x) => <line x1={x} y1="160" x2={x} y2="230" stroke={stripe} stroke-width="0.9" />)}
    </g>
    <path d={shorts} fill="none" stroke={kit.trim ?? outline} stroke-width="2" />
  </svg>
  <figcaption>
    <strong>{labels[kit.edition]}</strong>
    <span class="subtle">{kit.season}{kit.maker && ` · ${kit.maker}`}</span>
    <span class="muted">{kit.description}</span>
  </figcaption>
</figure>

<style>
  .kit {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 1.25rem 1rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
  }
  svg {
    width: min(100%, 9rem);
    height: auto;
    margin: 0 auto;
  }
  figcaption {
    display: grid;
    gap: 0.15rem;
    font-size: 0.875rem;
  }
  strong {
    font-family: var(--font-display);
    font-size: var(--step-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
