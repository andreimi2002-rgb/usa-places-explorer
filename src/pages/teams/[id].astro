---
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import EuropeBox from '../../components/EuropeBox.astro';
import FactBox from '../../components/FactBox.astro';
import Kit from '../../components/Kit.astro';
import LocalTime from '../../components/LocalTime.astro';
import Weather from '../../components/Weather.astro';
import Logo from '../../components/Logo.astro';
import MiniGraph from '../../components/MiniGraph.astro';
import Photo from '../../components/Photo.astro';
import PlayerCard, { type Tier } from '../../components/PlayerCard.astro';
import ProgressNote from '../../components/ProgressNote.astro';
import SourceList from '../../components/SourceList.astro';
import Term from '../../components/Term.astro';
import Timeline from '../../components/Timeline.astro';
import Base from '../../layouts/Base.astro';
import {
  championshipsOf, cityOf, identitiesOf, peopleOf, prose, rivalriesOf, routes, structureOf,
} from '../../lib/entities';
import { formatDate, isVerified, shown } from '../../lib/facts';

export async function getStaticPaths() {
  const franchises = await getCollection('franchises');
  return franchises.map((f) => ({ params: { id: f.id }, props: { franchise: f } }));
}

const { franchise } = Astro.props;
const d = franchise.data;
const { league, conference, division } = await structureOf(franchise);
const terms = league?.data.terms ?? { final: 'Finals', title: 'title', titles: 'Titles', rosterSite: 'the official site', kitsIntro: undefined };
const city = await cityOf(franchise.id);
const identities = await Promise.all(
  (await identitiesOf(franchise.id)).map(async (i) => ({ i, city: await getEntry(i.data.city) })),
);
const people = await peopleOf(franchise.id);
const rivalries = await rivalriesOf(franchise.id);
const championships = await championshipsOf(franchise.id);
const titles = championships.filter((c) => c.data.level === 'league' && c.data.winner?.id === franchise.id && c.data.verified);
const finalsLost = championships.filter((c) => c.data.level === 'league' && c.data.runnerUp?.id === franchise.id && c.data.verified);
const venueLinks = await Promise.all(d.venues.map(async (v) => ({ ...v, entry: await getEntry(v.venue) })));
const currentVenue = venueLinks.find((v) => v.to === null && v.verified)?.entry;

const sections = {
  why: await prose('franchises', franchise.id, 'why'),
  overview: await prose('franchises', franchise.id, 'overview'),
  europe: await prose('franchises', franchise.id, 'europe'),
  history: await prose('franchises', franchise.id, 'history'),
  venue: await prose('franchises', franchise.id, 'venue'),
  culture: await prose('franchises', franchise.id, 'fan-culture'),
};
const rendered = Object.fromEntries(
  await Promise.all(Object.entries(sections).map(async ([k, e]) => [k, e ? (await render(e)).Content : undefined])),
) as Record<keyof typeof sections, any>;

const colors = isVerified(d.colors) ? d.colors.value : [];
const accent = colors[0] ? { primary: colors[0].hex, secondary: colors[2]?.hex ?? colors[1]?.hex } : undefined;
const stub = d.progress === 'not-started';
const rivalryEntries = await Promise.all(
  rivalries.map(async (r) => ({ r, other: (await getEntries(r.data.franchises)).find((f) => f.id !== franchise.id) })),
);
const finalsSeasons = [...titles, ...finalsLost].map((c) => c.data.season).sort();
const finalsSummary =
  finalsSeasons.length === 0
    ? undefined
    : finalsSeasons.length <= 3
      ? finalsSeasons.join(', ')
      : `${finalsSeasons.length} times, most recently ${finalsSeasons.at(-1)}`;
const ROLE_LABELS = { player: 'Player', 'head-coach': 'Head coach', executive: 'Executive', owner: 'Owner', founder: 'Co-founder' } as const;
const legendIds = new Set(d.legends.map((r) => r.id));
const coreIds = new Set(d.corePlayers?.players.map((p) => p.person.id) ?? []);
const rookieIds = new Set(d.rookies?.players.map((p) => p.person.id) ?? []);
const byId = new Map(people.map((p) => [p.id, p]));
type PersonEntry = (typeof people)[number];
function card(p: PersonEntry, tier: Tier, note?: string) {
  const here = p.data.roles.filter((r) => r.franchise.id === franchise.id && r.verified);
  const kinds = [...new Set(here.map((r) => ROLE_LABELS[r.role]))].join(', ');
  const from = Math.min(...here.map((r) => r.from));
  const to = here.some((r) => r.to === null) ? 'today' : Math.max(...here.map((r) => r.to ?? 0));
  return {
    id: p.id,
    name: p.data.name,
    tier,
    position: shown(p.data.position),
    years: here.length ? `${kinds} · ${from}–${to}` : '',
    image: p.data.image ? { url: p.data.image.url, alt: p.data.image.alt } : undefined,
    facts: p.data.facts.filter((x) => x.verified).map((x) => ({ label: x.label, value: x.value })),
    note,
  };
}
const legendCards = d.legends.flatMap((r) => (byId.get(r.id) && !coreIds.has(r.id) ? [card(byId.get(r.id)!, 'legend')] : []));
const coreCards = (d.corePlayers?.players ?? [])
  .filter((x) => x.verified)
  .flatMap((x) => (byId.get(x.person.id) ? [card(byId.get(x.person.id)!, legendIds.has(x.person.id) ? 'legend' : 'core')] : []));
const rookieCards = (d.rookies?.players ?? [])
  .filter((x) => x.verified)
  .flatMap((x) => (byId.get(x.person.id) ? [card(byId.get(x.person.id)!, 'rookie', x.draft ? `${x.draft.year} draft: round ${x.draft.round}, pick ${x.draft.pick}` : x.note)] : []));
const notableCards = people
  .filter((p) => !legendIds.has(p.id) && !coreIds.has(p.id) && !rookieIds.has(p.id))
  .map((p) => card(p, 'notable'));
const finals = championships
  .filter((c) => c.data.level === 'league' && c.data.verified)
  .sort((a, b) => a.data.season.localeCompare(b.data.season))
  .map((c) => {
    const won = c.data.winner?.id === franchise.id;
    return {
      season: c.data.season,
      won,
      asName: won ? c.data.winnerName : c.data.runnerUpName,
      opponent: won ? c.data.runnerUpName : c.data.winnerName,
      opponentId: won ? c.data.runnerUp?.id : c.data.winner?.id,
      result: c.data.result,
    };
  });
const description = d.summary ?? `${d.name}: history, home venue, legends and rivalries, explained for newcomers.`;
const kits = d.kits.filter((k) => k.verified);
const kitSport = league?.data.sport.id === 'soccer' ? 'soccer' : 'basketball';
const logoFiles = import.meta.glob<string>('/src/assets/logos/**/*.svg', { eager: true, query: '?url', import: 'default' });
const crestUrl = d.logo ? logoFiles[`/src/assets/logos/${d.logo.file}`] : undefined;
const credits = [d.image, d.kitPhoto, currentVenue?.data.image, ...people.map((p) => p.data.image)];
---

<Base title={d.name} description={description} accent={accent}>
  <!-- 1. Hero -->
  <header class="hero">
    {d.image && <img class="hero-bg" src={d.image.url} alt="" />}
    <div class="container hero-inner">
      <Logo logo={d.logo} name={d.name} size={112} />
      <div>
        <span class="eyebrow">
          {league?.data.shortName}{conference && ` · ${conference.data.name}`}{division && ` · ${division.data.name}`}
        </span>
        <h1>{d.name}</h1>
        <ul class="hero-facts">
          {city && <li><span>City</span><a href={routes.cities(city.id)}>{city.data.name}</a></li>}
          {shown(d.founded) && <li><span>Founded</span>{shown(d.founded)}</li>}
          {currentVenue && <li><span>Home</span><a href={routes.venues(currentVenue.id)}>{currentVenue.data.name}</a></li>}
          <li><span>{terms.titles}</span>{titles.length}</li>
          {colors.length > 0 && (
            <li>
              <span>Colors</span>
              <span class="swatches">
                {colors.map((c) => <span class="swatch" style={`background:${c.hex}`} title={c.name} />)}
                <span class="sr-only">{colors.map((c) => c.name).join(', ')}</span>
              </span>
            </li>
          )}
        </ul>
      </div>
    </div>
  </header>

  {stub && (
    <div class="container section">
      <ProgressNote progress={d.progress} kind="team" />
    </div>
  )}

  {!stub && (
    <>
      <!-- 2. Why this team matters -->
      <section class="section container why" aria-labelledby="why-title">
        <div class="why-grid">
          <div>
            <span class="eyebrow">New to the {d.name}?</span>
            <h2 id="why-title">Why this team matters</h2>
            <div class="lede">{rendered.why && <rendered.why components={{ Term }} />}</div>
          </div>
          <FactBox
            title="At a glance"
            rows={[
              { label: 'First season', value: d.firstSeason?.value, source: d.firstSeason?.source, verified: d.firstSeason?.verified },
              { label: 'Owner', value: d.owner?.value, source: d.owner?.source, verified: d.owner?.verified },
              {
                label: `Head coach (${d.headCoach?.asOf ?? ''})`,
                value: d.headCoach?.name,
                source: d.headCoach?.source,
                verified: d.headCoach?.verified,
              },
              {
                label: `${terms.final} reached`,
                value: finalsSummary,
                source: finalsLost[0]?.data.source,
                verified: finalsLost[0]?.data.verified ?? titles[0]?.data.verified,
              },
            ]}
          />
        </div>
      </section>

      <!-- 2b. The club today: identity, how the team is built, records -->
      {rendered.overview && (
        <section class="section container" aria-labelledby="overview-title">
          <div class="section-head"><h2 id="overview-title">The club today</h2></div>
          <div class="prose"><rendered.overview components={{ Term }} /></div>
        </section>
      )}

      <!-- 3. History by eras -->
      {rendered.history && (
        <section class="section container" aria-labelledby="history-title">
          <div class="section-head"><h2 id="history-title">History by eras</h2></div>
          <div class="prose"><rendered.history components={{ Term }} /></div>
        </section>
      )}

      <!-- 4. Home venue -->
      {currentVenue && (
        <section class="section container" aria-labelledby="venue-title">
          <div class="section-head"><h2 id="venue-title">Home venue</h2></div>
          <div class="split">
            {currentVenue.data.image && <Photo image={currentVenue.data.image} aspect="4 / 3" />}
            <div>
              <h3><a href={routes.venues(currentVenue.id)}>{currentVenue.data.name}</a></h3>
              <div class="prose">{rendered.venue && <rendered.venue components={{ Term }} />}</div>
              <ul class="venue-years">
                {venueLinks.filter((v) => v.verified).map((v) => (
                  <li>
                    <a href={routes.venues(v.venue.id)}>{v.entry?.data.name}</a>
                    <span class="subtle"> {v.from}–{v.to ?? 'today'}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )}

      <!-- 4b. Uniforms -->
      {kits.length > 0 && (
        <section class="section container" aria-labelledby="kits-title">
          <div class="section-head"><h2 id="kits-title">Uniforms</h2></div>
          <p class="muted kits-intro">
            {terms.kitsIntro && <Fragment set:html={terms.kitsIntro} />}{' '}The drawings are our own, made from the colours and patterns of the {kits[0].season} kits; they are not the exact designs and leave out sponsor logos.
          </p>
          <div class="kits">
            <ul class="kit-list">
              {kits.map((k, i) => <li><Kit kit={k} uid={`${franchise.id}-${i}`} sport={kitSport} crest={crestUrl} /></li>)}
            </ul>
            {d.kitPhoto && <Photo image={d.kitPhoto} aspect="3 / 4" class="kit-photo" />}
          </div>
        </section>
      )}

      <!-- 5. Championships & milestones -->
      {d.milestones.length > 0 && (
        <section class="section container" aria-labelledby="timeline-title">
          <div class="section-head"><h2 id="timeline-title">Championships &amp; milestones</h2></div>
          <p class="muted">
            {titles.length === 0
              ? `${d.name} have not won an ${terms.title} yet.${finalsLost.length === 0 ? '' : ` They have reached the ${terms.final} ${finalsLost.length === 1 ? 'once' : finalsLost.length === 2 ? 'twice' : `${finalsLost.length} times`}.`}`
              : `${titles.length} ${titles.length === 1 ? terms.title : terms.titles}.`}
          </p>
          {finals.length > 0 && (
            <div class="finals-wrap">
              <table class="finals">
                <caption class="sr-only">Every {terms.final} appearance</caption>
                <thead><tr><th scope="col">Season</th><th scope="col">Result</th><th scope="col">Opponent</th><th scope="col">Score</th></tr></thead>
                <tbody>
                  {finals.map((x) => (
                    <tr class:list={[{ won: x.won }]}>
                      <td>{x.season}{x.asName && x.asName !== d.name && <span class="subtle"> as {x.asName}</span>}</td>
                      <td>{x.won ? 'Champions' : 'Runners-up'}</td>
                      <td>{x.opponentId ? <a href={routes.franchises(x.opponentId)}>{x.opponent}</a> : x.opponent}</td>
                      <td>{x.result}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          <Timeline items={d.milestones} />
        </section>
      )}

      <!-- 6. Players: core, rookies, legends, notable -->
      {[
        { key: 'core', title: `Core players (${d.corePlayers?.asOf ?? ''})`, cards: coreCards,
          intro: 'The faces of this season’s team, not the full roster.', link: d.corePlayers?.rosterUrl },
        { key: 'rookies', title: `Rookies (${d.rookies?.asOf ?? ''})`, cards: rookieCards, intro: 'First-year players on this season’s roster.' },
        { key: 'legends', title: 'Legends', cards: legendCards, intro: 'The players and builders who define the club.' },
        { key: 'notable', title: 'Notable players', cards: notableCards, intro: 'Other well-known names who played or worked here.' },
      ].filter((g) => g.cards.length > 0 || (g.key === 'rookies' && d.rookies?.note)).map((g) => (
        <section class="section container" aria-labelledby={`${g.key}-title`}>
          <div class="section-head"><h2 id={`${g.key}-title`}>{g.title}</h2></div>
          <p class="muted cards-intro">
            {g.intro}{g.cards.length > 0 && ' Tap a card to flip it.'}
            {g.link && <> <a href={g.link} rel="noopener" target="_blank">Full roster on {terms.rosterSite} →</a></>}
          </p>
          {g.cards.length > 0 ? (
            <ul class="card-grid">
              {g.cards.map((c) => <li><PlayerCard {...c} /></li>)}
            </ul>
          ) : (
            <p class="empty-note">
              {d.rookies?.note}{' '}
              {d.rookies?.noteSource && <a href={d.rookies.noteSource} rel="noopener" target="_blank">Source</a>}
            </p>
          )}
        </section>
      ))}

      <!-- 7. Rivalries -->
      {rivalryEntries.length > 0 && (
        <section class="section container" aria-labelledby="rivalries-title">
          <div class="section-head"><h2 id="rivalries-title">Rivalries</h2></div>
          <ul class="grid grid-2 cards">
            {rivalryEntries.map(({ r, other }) => (
              <li class="card rivalry">
                <div class="card-body">
                  <span class="eyebrow">vs. {other?.data.name}{r.data.nickname && ` · ${r.data.nickname}`}</span>
                  <h3><a href={routes.rivalries(r.id)} class="stretched">{r.data.name}</a></h3>
                  <p class="muted">{r.data.summary}</p>
                  <span class="chip">Why it matters →</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- 8. City & fan culture -->
      {rendered.culture && (
        <section class="section container" aria-labelledby="culture-title">
          <div class="section-head"><h2 id="culture-title">{sections.culture?.data.title ?? "City & fan culture"}</h2></div>
          <div class="split">
            <div class="prose"><rendered.culture components={{ Term }} /></div>
            {city?.data.image && <Photo image={city.data.image} aspect="4 / 3" />}
          </div>
        </section>
      )}
    </>
  )}

  <!-- 8b. For European fans -->
  {!stub && rendered.europe && (
    <div class="section container">
      <EuropeBox><rendered.europe components={{ Term }} /></EuropeBox>
    </div>
  )}

  <!-- 9. Identity history -->
  <section class="section container" aria-labelledby="identity-title">
    <div class="section-head"><h2 id="identity-title">Identity history</h2></div>
    <p class="muted">
      A franchise can change its name or city and stay the same organization. These are every name this franchise has used.
    </p>
    <ol class="identities">
      {identities.map(({ i, city: c }) => (
        <li class:list={[{ current: i.data.current }]}>
          <strong>{i.data.name}</strong>
          <span class="muted"> · {c?.data.name}</span>
          <span class="subtle"> · {shown(i.data.from) ?? 'start date not yet verified'}–{i.data.to ?? 'today'}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- 10. Explore connections -->
  <div class="section container">
    <MiniGraph type="franchise" id={franchise.id} />
  </div>

  <!-- 11. Local time and live weather -->
  {city && (
    <div class="section container time-weather">
      <LocalTime city={city.data.name} timezone={city.data.timezone} />
      {city.data.coordinates?.verified && (
        <Weather city={city.data.name} lat={city.data.coordinates.value.lat} lon={city.data.coordinates.value.lon} timezone={city.data.timezone} />
      )}
    </div>
  )}

  <!-- 12. Sources & image credits -->
  <div class="section container">
    <SourceList sources={d.sources} credits={credits} />
    {d.logo?.official && (
      <p class="subtle updated">
        Logo: a trademark of the {d.name}, shown for identification only. File from{' '}
        {d.logo.source ? <a href={d.logo.source} rel="noopener" target="_blank">{terms.rosterSite}</a> : 'the team'}.
      </p>
    )}
    <p class="subtle updated">Status: {d.progress.replace('-', ' ')}. Facts checked {formatDate(d.sources[0]?.accessed ?? '2026-11-05')}.</p>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4rem, 12vw, 8rem) 0 3rem;
    background: radial-gradient(ellipse at top left, color-mix(in srgb, var(--team-1) 45%, transparent), transparent 60%), var(--bg-sunk);
    border-bottom: 1px solid var(--line);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(10, 15, 26, 0.3), var(--bg) 95%);
  }
  .hero-inner {
    display: flex;
    gap: 1.5rem;
    align-items: flex-end;
    flex-wrap: wrap;
  }
  .hero .eyebrow {
    color: color-mix(in srgb, var(--team-1) 55%, #fff);
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .hero-facts li {
    display: grid;
    font-weight: 600;
  }
  .hero-facts li > span:first-child {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-subtle);
    font-weight: 600;
  }
  .hero-facts a {
    color: var(--text);
  }
  .swatches {
    display: flex;
    gap: 0.3rem;
    padding-top: 0.25rem;
  }
  .why-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 960px) {
    .why-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .why .eyebrow,
  .card .eyebrow {
    color: color-mix(in srgb, var(--team-1) 55%, #fff);
  }
  .split {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .split h3 {
    margin-bottom: 0.75rem;
  }
  .split h3 a {
    color: var(--text);
  }
  .venue-years {
    padding-left: 1.1rem;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--team-1);
    transform: translateY(-2px);
  }
  .card-body {
    padding: 1.1rem 1.25rem 1.25rem;
  }
  .card h3 {
    font-size: var(--step-3);
    margin-bottom: 0.4rem;
  }
  .card h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .portrait {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 20%;
    background: var(--surface);
  }
  .placeholder {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--text-subtle);
    background: linear-gradient(135deg, color-mix(in srgb, var(--team-1) 35%, var(--surface)), var(--surface));
  }
  .rivalry {
    border-left: 4px solid #e24b4b;
  }
  .identities {
    padding-left: 1.2rem;
  }
  .identities li.current strong {
    color: var(--team-1);
  }
  .kits {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .kits {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .kits-intro {
    max-width: 60ch;
  }
  .kit-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11.5rem), 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .empty-note {
    padding: 1rem 1.25rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
  }
  .cards-intro {
    margin-bottom: 1.25rem;
  }
  .finals-wrap {
    overflow-x: auto;
    margin: 1rem 0 2rem;
  }
  .finals {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .finals th,
  .finals td {
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .finals th {
    font-size: 0.7rem;
    text-transform: uppercase;
