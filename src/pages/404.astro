---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist." noindex searchable={false}>
  <div class="container section">
    <span class="eyebrow">404</span>
    <h1>Out of bounds</h1>
    <p class="lede muted">This page does not exist, or has not been written yet.</p>
    <p><a class="button" href="/">Back to the home page</a></p>
  </div>
</Base>
