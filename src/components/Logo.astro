---
/**
 * Team logo, resolved from the path stored in the franchise data
 * (src/assets/logos/<league>/<id>.svg). Logos are temporary placeholders and
 * can all be swapped from that one folder. Falls back to initials.
 */
interface Props {
  path?: string;
  name: string;
  size?: number;
  color?: string;
}
const { path, name, size = 96, color = 'var(--team-1)' } = Astro.props;
const files = import.meta.glob<string>('/src/assets/logos/**/*.svg', { eager: true, query: '?url', import: 'default' });
const url = path ? files[`/src/assets/logos/${path}`] : undefined;
if (path && !url) throw new Error(`Logo not found: src/assets/logos/${path}`);
const initials = name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 3)
  .toUpperCase();
---

{
  url ? (
    <img class="logo" src={url} alt={`${name} logo (placeholder)`} width={size} height={size} />
  ) : (
    <span class="logo initials" style={`width:${size}px;height:${size}px;background:${color}`} aria-hidden="true">
      {initials}
    </span>
  )
}

<style>
  .logo {
    flex: none;
    border-radius: 50%;
  }
  .initials {
    display: grid;
    place-items: center;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6em;
    letter-spacing: 0.04em;
    border: 2px solid rgba(255, 255, 255, 0.25);
  }
</style>
