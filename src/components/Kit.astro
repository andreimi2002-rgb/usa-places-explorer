---
/**
 * A uniform diagram drawn from the kit data: a basketball jersey and shorts, or a soccer shirt,
 * shorts and socks. It shows only what the data records (colours, pattern, trim, wordmark) plus the
 * team crest, with soft shading so it reads as fabric. It is our own drawing, not the real design.
 */
interface Props {
  kit: {
    edition: string;
    season: string;
    base: string;
    panel?: string;
    trim?: string;
    pinstripes: boolean;
    pattern?: string;
    patternColor?: string;
    sleeves?: string;
    collar?: string;
    shorts?: string;
    socks?: string;
    name?: string;
    sponsor?: string;
    wordmark?: string;
    maker?: string;
    description: string;
  };
  uid: string;
  sport?: 'basketball' | 'soccer';
  /** Team crest image URL, drawn small on the chest. */
  crest?: string;
}
const { kit, uid, sport = 'basketball', crest } = Astro.props;

function luminance(hex: string) {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}
const light = (hex: string) => luminance(hex) > 0.45;
const ink = light(kit.base) ? '#1b2333' : '#ffffff';
const outline = light(kit.base) ? 'rgba(27,35,51,0.45)' : 'rgba(255,255,255,0.28)';
const pattern = kit.pattern ?? (kit.pinstripes ? 'pinstripes' : 'plain');
const pc = kit.patternColor ?? kit.trim ?? (light(kit.base) ? '#1b2333' : '#ffffff');
const trim = kit.trim ?? kit.collar;
const shortsColor = kit.shorts ?? kit.base;
const socksColor = kit.socks ?? shortsColor;
const sleevesColor = kit.sleeves ?? kit.panel ?? kit.base;
const collarColor = kit.collar ?? trim ?? kit.base;

const labels: Record<string, string> = {
  association: 'Association', icon: 'Icon', statement: 'Statement', city: 'City', classic: 'Classic',
  home: 'Home', away: 'Away', third: 'Third', alternate: 'Alternate',
};
const soccer = sport === 'soccer';

// Shapes (viewBox 0 0 200 300).
const B = {
  jersey: 'M70 14 Q100 46 130 14 L156 20 Q160 60 186 74 L182 196 Q100 206 18 196 L14 74 Q40 60 44 20 Z',
  neck: 'M70 14 Q100 46 130 14',
  armL: 'M44 20 Q40 60 14 74',
  armR: 'M156 20 Q160 60 186 74',
  shorts: 'M20 210 Q100 218 180 210 L190 292 L112 292 L100 252 L88 292 L10 292 Z',
};
const S = {
  shirt: 'M74 12 Q100 30 126 12 L160 22 L198 60 L178 92 L156 78 L158 198 Q100 206 42 198 L44 78 L22 92 L2 60 L40 22 Z',
  body: 'M44 30 L156 30 L158 198 Q100 206 42 198 Z',
  sleeveL: 'M40 22 L2 60 L22 92 L44 78 Z',
  sleeveR: 'M160 22 L198 60 L178 92 L156 78 Z',
  collar: 'M74 12 Q100 30 126 12 L120 8 Q100 22 80 8 Z',
  shorts: 'M44 206 Q100 212 156 206 L162 258 L106 258 L100 236 L94 258 L38 258 Z',
  sockL: 'M46 266 L92 266 L90 298 L48 298 Z',
  sockR: 'M108 266 L154 266 L152 298 L110 298 Z',
};
const pins = Array.from({ length: 24 }, (_, i) => 4 + i * 8);
const wide = Array.from({ length: 6 }, (_, i) => 10 + i * 34);
const hoops = Array.from({ length: 6 }, (_, i) => 30 + i * 30);
const clip = `k-${uid}`;
const shirtPath = soccer ? S.shirt : B.jersey;
---

<figure class="kit">
  <svg viewBox="0 0 200 300" role="img" aria-label={`${labels[kit.edition]} kit, ${kit.season}: ${kit.description}`}>
    <defs>
      <clipPath id={`${clip}-shirt`}><path d={shirtPath} /></clipPath>
      <clipPath id={`${clip}-shorts`}><path d={soccer ? S.shorts : B.shorts} /></clipPath>
      <linearGradient id={`${clip}-shade`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#000" stop-opacity="0.28" />
        <stop offset="0.22" stop-color="#000" stop-opacity="0" />
        <stop offset="0.5" stop-color="#fff" stop-opacity="0.10" />
        <stop offset="0.78" stop-color="#000" stop-opacity="0" />
        <stop offset="1" stop-color="#000" stop-opacity="0.30" />
      </linearGradient>
      <linearGradient id={`${clip}-top`} x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="0.12" />
        <stop offset="0.6" stop-color="#000" stop-opacity="0" />
        <stop offset="1" stop-color="#000" stop-opacity="0.18" />
      </linearGradient>
      <pattern id={`${clip}-tex`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
        <rect width="6" height="6" fill="none" />
        <line x1="0" y1="0" x2="0" y2="6" stroke={pc} stroke-width="1.6" stroke-opacity="0.16" />
      </pattern>
    </defs>

    <!-- Shirt -->
    <g clip-path={`url(#${clip}-shirt)`}>
      <rect width="200" height="210" fill={kit.base} />
      {soccer && <><path d={S.sleeveL} fill={sleevesColor} /><path d={S.sleeveR} fill={sleevesColor} /></>}
      {!soccer && kit.panel && <path d="M0 0 H200 V70 Q100 86 0 70 Z" fill={kit.panel} />}
      {pattern === 'pinstripes' && pins.map((x) => <line x1={x} y1="0" x2={x} y2="210" stroke={pc} stroke-opacity="0.45" stroke-width="1.2" />)}
      {pattern === 'stripes' && wide.map((x) => <rect x={x} y="0" width="16" height="210" fill={pc} />)}
      {pattern === 'hoops' && hoops.map((y) => <rect x="0" y={y} width="200" height="14" fill={pc} />)}
      {pattern === 'sash' && <path d="M30 0 L80 0 L190 210 L140 210 Z" fill={pc} />}
      {pattern === 'band' && <rect x="0" y="78" width="200" height="30" fill={pc} />}
      {pattern === 'halves' && <rect x="100" y="0" width="100" height="210" fill={pc} />}
      {pattern === 'texture' && <rect width="200" height="210" fill={`url(#${clip}-tex)`} />}
      {!soccer && kit.trim && kit.panel && (
        <><rect x="0" y="76" width="200" height="4" fill={kit.trim} /><rect x="0" y="112" width="200" height="4" fill={kit.trim} /></>
      )}
      <rect width="200" height="210" fill={`url(#${clip}-shade)`} />
      <rect width="200" height="210" fill={`url(#${clip}-top)`} />
      <!-- fabric folds -->
      <path d="M70 120 Q76 160 66 196 M132 110 Q126 150 136 196" stroke="#000" stroke-opacity="0.08" stroke-width="3" fill="none" />
    </g>
    {soccer ? (
      <>
        <path d={S.collar} fill={collarColor} />
        <path d="M2 60 L22 92 M198 60 L178 92" stroke={trim ?? outline} stroke-width="4" stroke-linecap="round" />
      </>
    ) : (
      <>
        <path d={B.neck} fill="none" stroke={trim ?? outline} stroke-width="5" />
        <path d={B.armL} fill="none" stroke={trim ?? outline} stroke-width="5" />
        <path d={B.armR} fill="none" stroke={trim ?? outline} stroke-width="5" />
      </>
    )}
    <path d={shirtPath} fill="none" stroke={outline} stroke-width="1.5" />

    {soccer && crest && <image href={crest} x="116" y="46" width="26" height="26" preserveAspectRatio="xMidYMid meet" />}
    {!soccer && kit.wordmark && (
      <text x="100" y="108" text-anchor="middle" fill={ink} font-family="var(--font-display)" font-weight="700" font-size="26" letter-spacing="1.5">{kit.wordmark}</text>
    )}
    {!soccer && !kit.wordmark && crest && <image href={crest} x="78" y="74" width="44" height="44" preserveAspectRatio="xMidYMid meet" />}

    <!-- Shorts -->
    <g clip-path={`url(#${clip}-shorts)`}>
      <rect y="200" width="200" height="100" fill={shortsColor} />
      {!soccer && pattern === 'pinstripes' && pins.map((x) => <line x1={x} y1="200" x2={x} y2="300" stroke={pc} stroke-opacity="0.45" stroke-width="1.2" />)}
      {!soccer && trim && <><rect x="10" y="200" width="7" height="100" fill={trim} /><rect x="183" y="200" width="7" height="100" fill={trim} /></>}
      <rect y="200" width="200" height="100" fill={`url(#${clip}-shade)`} />
    </g>
    <path d={soccer ? S.shorts : B.shorts} fill="none" stroke={light(shortsColor) ? 'rgba(27,35,51,0.45)' : 'rgba(255,255,255,0.28)'} stroke-width="1.5" />

    {soccer && (
      <>
        <path d={S.sockL} fill={socksColor} />
        <path d={S.sockR} fill={socksColor} />
        <rect x="46" y="266" width="46" height="5" fill={trim ?? outline} opacity="0.8" />
        <rect x="108" y="266" width="46" height="5" fill={trim ?? outline} opacity="0.8" />
        <path d={`${S.sockL} ${S.sockR}`} fill="none" stroke={light(socksColor) ? 'rgba(27,35,51,0.45)' : 'rgba(255,255,255,0.28)'} stroke-width="1.2" />
      </>
    )}
  </svg>
  <figcaption>
    <strong>{kit.name ?? `${labels[kit.edition]}${soccer ? ' kit' : ''}`}</strong>
    <span class="subtle">{[labels[kit.edition], kit.season, kit.maker].filter(Boolean).join(' · ')}</span>
    <span class="desc">{kit.description}</span>
    {kit.sponsor && <span class="sponsor">{soccer ? 'Shirt sponsor' : 'Jersey patch'}: {kit.sponsor}</span>}
  </figcaption>
</figure>

<style>
  .kit {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    text-align: center;
  }
  svg {
    width: 100%;
    max-width: 190px;
    height: auto;
    filter: drop-shadow(0 14px 18px rgba(0, 0, 0, 0.45));
  }
  figcaption {
    display: grid;
    gap: 0.2rem;
    font-size: var(--step--1);
  }
  figcaption strong {
    font-size: var(--step-0);
  }
  .desc {
    color: var(--text-muted);
  }
  .sponsor {
    margin-top: 0.2rem;
    color: var(--text-subtle);
    font-size: 0.8rem;
  }
</style>
