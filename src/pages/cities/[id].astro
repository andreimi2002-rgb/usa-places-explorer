---
import { getCollection, render } from 'astro:content';
import EntityHeader from '../../components/EntityHeader.astro';
import FactBox from '../../components/FactBox.astro';
import LocalTime from '../../components/LocalTime.astro';
import MiniGraph from '../../components/MiniGraph.astro';
import Photo from '../../components/Photo.astro';
import ProgressNote from '../../components/ProgressNote.astro';
import SourceList from '../../components/SourceList.astro';
import Term from '../../components/Term.astro';
import Base from '../../layouts/Base.astro';
import { franchisesInCity, prose, routes } from '../../lib/entities';
import { formatNumber } from '../../lib/facts';

export async function getStaticPaths() {
  return (await getCollection('cities')).map((c) => ({ params: { id: c.id }, props: { city: c } }));
}
const { city } = Astro.props;
const d = city.data;
const teams = await franchisesInCity(city.id);
const venues = await getCollection('venues', (v) => v.data.city.id === city.id);
const body = await prose('cities', city.id, 'body');
const Body = body ? (await render(body)).Content : undefined;
---

<Base title={`${d.name}, ${d.region}`} description={d.summary ?? `${d.name}: its teams, venues and local time compared with Europe.`}>
  <EntityHeader
    eyebrow={`City · ${d.region}, ${d.country}`}
    title={d.name}
    intro={d.summary}
    image={d.image}
    crumbs={[{ label: 'Home', href: '/' }, { label: d.name }]}
  />
  <div class="container section layout">
    <article>
      <ProgressNote progress={d.progress} kind="city page" />
      {Body && <div class="prose"><Body components={{ Term }} /></div>}
      {d.image && <Photo image={d.image} class="mt" />}
      <h2 class="mt">Teams</h2>
      <ul>{teams.map((t) => <li><a href={routes.franchises(t.id)}>{t.data.name}</a></li>)}</ul>
      {venues.length > 0 && (
        <>
          <h2 class="mt">Venues</h2>
          <ul>{venues.map((v) => <li><a href={routes.venues(v.id)}>{v.data.name}</a>{v.data.status === 'historical' && <span class="subtle"> (historical)</span>}</li>)}</ul>
        </>
      )}
    </article>
    <aside>
      <LocalTime city={d.name} timezone={d.timezone} />
      <div class="mt">
        <FactBox
          title="Key facts"
          rows={[
            { label: 'Population', value: d.population ? formatNumber(d.population.value) : undefined, source: d.population?.source, verified: d.population?.verified },
            { label: 'Time zone', value: d.timezone },
          ]}
        />
      </div>
    </aside>
  </div>
  <div class="container section"><MiniGraph type="city" id={city.id} /></div>
  <div class="container section"><SourceList sources={d.sources} credits={[d.image]} /></div>
</Base>

<style>
  .layout {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }
  .mt {
    margin-top: 2rem;
  }
</style>
