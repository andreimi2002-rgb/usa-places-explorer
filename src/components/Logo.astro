---
/**
 * Team logo, resolved from the franchise data (src/assets/logos/<league>/<id>.svg).
 * Official logos are trademarks of their owners, shown for identification only.
 * Falls back to initials.
 */
interface Props {
  logo?: { file: string; official: boolean };
  name: string;
  size?: number;
  color?: string;
}
const { logo, name, size = 96, color = 'var(--team-1)' } = Astro.props;
const path = logo?.file;
const files = import.meta.glob<string>('/src/assets/logos/**/*.svg', { eager: true, query: '?url', import: 'default' });
const url = path ? files[`/src/assets/logos/${path}`] : undefined;
if (path && !url) throw new Error(`Logo not found: src/assets/logos/${path}`);
const initials = name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 3)
  .toUpperCase();
---

{
  url ? (
    <img class="logo" src={url} alt={logo?.official ? `${name} logo` : `${name} logo (placeholder)`} width={size} height={size} style={`width:${size}px;height:${size}px;padding:${Math.round(size * 0.1)}px`} />
  ) : (
    <span class="logo initials" style={`width:${size}px;height:${size}px;background:${color}`} aria-hidden="true">
      {initials}
    </span>
  )
}

<style>
  .logo {
    flex: none;
    object-fit: contain;
  }
  /* Official artwork often uses black, so it sits on a light badge. */
  img.logo {
    box-sizing: border-box;
    border-radius: 18%;
    background: #f3f5f9;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
  }
  .initials {
    border-radius: 50%;
  }
  .initials {
    display: grid;
    place-items: center;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6em;
    letter-spacing: 0.04em;
    border: 2px solid rgba(255, 255, 255, 0.25);
  }
</style>
