---
import { siteConfig } from '../site.config';
---

<footer class="site-footer">
  <div class="container">
    <p class="disclaimer">{siteConfig.disclaimer}</p>
    <p class="subtle">
      Facts are checked against the sources listed on each page. Photos come from Wikimedia Commons under free
      licenses, credited where they appear. Logos shown are temporary placeholders.
    </p>
    <p class="subtle">
      <a href="/glossary/">Glossary</a> · <a href="/graph/">Connections</a> · <a href="/search/">Search</a> ·
      <a href="/status/">Status</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding-block: 2.5rem;
    background: var(--bg-sunk);
    border-top: 1px solid var(--line);
  }
  .disclaimer {
    color: var(--text);
    font-weight: 600;
    max-width: 48rem;
  }
  .subtle a {
    color: var(--text-muted);
  }
</style>
