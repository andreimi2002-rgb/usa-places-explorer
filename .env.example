# America 360 — environment variables (placeholders only). Copy to .env.local.

# Data mode: "fixture"  = bundled, attributed fixture data; no database needed
#            "database" = reads PostgreSQL/PostGIS through DATABASE_READER_URL
DATA_MODE=fixture

# UI locale: "en" or "ro". Proper names and US terminology are never translated.
NEXT_PUBLIC_LOCALE=en

# Server-only. Owner connection used by migrations and seed scripts.
DATABASE_URL=postgres://a360_owner:a360_local_dev@127.0.0.1:5433/america360
# Server-only. Least-privilege read-only role used by the website in database mode.
DATABASE_READER_URL=postgres://a360_reader:CHANGE_ME@127.0.0.1:5433/america360
# Password assigned to the a360_reader role by `npm run db:migrate` (local only).
A360_READER_PASSWORD=CHANGE_ME

# docker compose override (optional)
POSTGRES_PORT=5433
