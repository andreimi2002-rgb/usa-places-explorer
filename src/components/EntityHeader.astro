---
/** Page header for non-team entities: big title over an optional photo. */
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  image?: { url: string; alt: string };
  crumbs?: { label: string; href?: string }[];
}
const { eyebrow, title, intro, image, crumbs = [] } = Astro.props;
---

<header class="ehead">
  {image && <img class="bg" src={image.url} alt="" />}
  <div class="container inner">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="crumbs">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> / </span>}
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )
    }
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</header>

<style>
  .ehead {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(3.5rem, 10vw, 7rem) 0 2.5rem;
    border-bottom: 1px solid var(--line);
    background: radial-gradient(ellipse at top left, color-mix(in srgb, var(--team-1) 30%, transparent), transparent 60%), var(--bg-sunk);
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.32;
  }
  .ehead::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(10, 15, 26, 0.25), var(--bg) 96%);
  }
  .crumbs {
    font-size: var(--step--1);
    color: var(--text-subtle);
    margin-bottom: 1rem;
  }
  .crumbs a {
    color: var(--text-muted);
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
  }
  .eyebrow {
    color: color-mix(in srgb, var(--team-1) 55%, #fff);
  }
  .lede {
    margin-top: 1rem;
    color: var(--text-muted);
  }
</style>
