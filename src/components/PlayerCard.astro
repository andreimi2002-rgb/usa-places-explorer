---
/**
 * A trading-card style player card. Front: photo (or a team-colored initials
 * panel when no free photo exists), tier badge, name, position, years at the club.
 * Back: verified facts. The card flips on click or Enter/Space; both faces stay
 * in the accessibility tree, so screen readers get everything without flipping.
 * Original design, colored by the page's --team-1 / --team-2 variables.
 */
import { routes } from '../lib/entities';

export type Tier = 'legend' | 'core' | 'rookie' | 'notable';
interface Props {
  id: string;
  name: string;
  tier: Tier;
  /** e.g. "Guard" */
  position?: string;
  /** e.g. "Player · 1992–1996" */
  years: string;
  image?: { url: string; alt: string };
  /** Facts for the back, already filtered to verified ones. */
  facts: { label: string; value: string }[];
  /** Small line on the front, e.g. "Pick 16, 2026 draft". */
  note?: string;
}
const { id, name, tier, position, years, image, facts, note } = Astro.props;
const badge = { legend: 'Legend', core: 'Core', rookie: 'RC', notable: 'Notable' }[tier];
const initials = name
  .replace(/[’'.]/g, '')
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
const backId = `back-${id}-${tier}`;
---

<div class:list={['pcard', `tier-${tier}`]}>
  <div class="inner" role="button" tabindex="0" aria-pressed="false" aria-label={`${name}: show card back`} data-flip>
    <div class="face front">
      <div class="art">
        {image ? <img src={image.url} alt={image.alt} loading="lazy" decoding="async" /> : <span class="initials" aria-hidden="true">{initials}</span>}
        <span class="badge">{badge}</span>
      </div>
      <div class="plate">
        <strong class="name">{name}</strong>
        <span class="meta">{[position, years].filter(Boolean).join(' · ')}</span>
        {note && <span class="note">{note}</span>}
      </div>
    </div>
    <div class="face back" id={backId}>
      <strong class="name">{name}</strong>
      <dl>
        {facts.slice(0, 5).map((f) => (
          <>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </>
        ))}
      </dl>
      <a href={routes.people(id)} class="profile">Full profile →</a>
    </div>
  </div>
</div>

<script>
  // One delegated handler for every card on the page.
  const toggle = (el: HTMLElement) => {
    const on = el.getAttribute('aria-pressed') !== 'true';
    el.setAttribute('aria-pressed', String(on));
    el.classList.toggle('flipped', on);
  };
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('a')) return;
    const card = t.closest<HTMLElement>('[data-flip]');
    if (card) toggle(card);
  });
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if ((e.key === 'Enter' || e.key === ' ') && t.matches('[data-flip]')) {
      e.preventDefault();
      toggle(t);
    }
  });
</script>

<style>
  .pcard {
    --frame: var(--team-1);
    --frame-2: var(--team-2, #c4ced4);
    perspective: 1200px;
    aspect-ratio: 5 / 7;
  }
  .tier-legend {
    --frame: #d4a537;
    --frame-2: #f6dc8a;
  }
  .inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.5s ease;
    cursor: pointer;
    border-radius: 14px;
  }
  .inner:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .inner.flipped {
    transform: rotateY(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .inner {
      transition: none;
    }
  }
  .face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 14px;
    padding: 7px;
    background: linear-gradient(145deg, var(--frame), var(--frame-2) 55%, var(--frame));
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
    backface-visibility: hidden;
  }
  .front {
    gap: 6px;
  }
  .art {
    position: relative;
    flex: 1;
    overflow: hidden;
    border-radius: 9px;
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0 8px, transparent 8px 16px),
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--team-1) 70%, #fff 10%), var(--bg-sunk));
  }
  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }
  .initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 9vw, 3.5rem);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.04em;
  }
  .badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 2px 9px;
    border-radius: 999px;
    background: rgba(10, 15, 26, 0.85);
    color: var(--frame-2);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tier-rookie .badge {
    color: #fff;
    background: #c8102e;
  }
  .plate {
    display: grid;
    gap: 1px;
    padding: 7px 9px 8px;
    border-radius: 8px;
    background: rgba(10, 15, 26, 0.92);
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #fff;
  }
  .meta,
  .note {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .note {
    color: var(--frame-2);
  }
  .back {
    transform: rotateY(180deg);
    gap: 0.5rem;
    padding: 14px;
    background: linear-gradient(160deg, rgba(10, 15, 26, 0.96), rgba(10, 15, 26, 0.9)), var(--frame);
    border: 7px solid var(--frame);
  }
  dl {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    font-size: 0.78rem;
  }
  dt {
    margin-top: 0.35rem;
    color: var(--text-subtle);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  dd {
    margin: 0;
    color: var(--text);
  }
  .profile {
    margin-top: auto;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--frame-2);
  }
</style>
