---
const nav = [
  { label: 'NBA', href: '/leagues/nba/' },
  { label: 'MLS', href: '/leagues/mls/' },
  { label: 'NFL', href: '/leagues/nfl/' },
  { label: 'Cities', href: '/cities/' },
  { label: 'Glossary', href: '/glossary/' },
  { label: 'Connections', href: '/graph/' },
  { label: 'Search', href: '/search/' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="American Sports Encyclopedia, home">
      <span class="mark" aria-hidden="true">ASE</span>
      <span class="name">American Sports<br />Encyclopedia</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 11, 19, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 6px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.95rem;
    line-height: 1;
    letter-spacing: 0.05em;
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  nav a {
    display: block;
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface);
  }
  @media (max-width: 520px) {
    .name {
      display: none;
    }
  }
</style>
