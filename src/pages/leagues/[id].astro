---
import { getCollection, getEntry, render } from 'astro:content';
import EntityHeader from '../../components/EntityHeader.astro';
import Logo from '../../components/Logo.astro';
import SourceList from '../../components/SourceList.astro';
import Term from '../../components/Term.astro';
import Base from '../../layouts/Base.astro';
import { cityOf, prose, routes } from '../../lib/entities';

export async function getStaticPaths() {
  return (await getCollection('leagues')).map((l) => ({ params: { id: l.id }, props: { league: l } }));
}
const { league } = Astro.props;
const d = league.data;
const sport = await getEntry(d.sport);
const conferences = (await getCollection('conferences', (c) => c.data.league.id === league.id)).sort((a, b) => a.data.order - b.data.order);
const divisions = await getCollection('divisions');
const franchises = await getCollection('franchises', (f) => f.data.league.id === league.id);
const structure = await Promise.all(
  conferences.map(async (c) => ({
    c,
    divisions: await Promise.all(
      divisions
        .filter((dv) => dv.data.conference.id === c.id)
        .sort((a, b) => a.data.order - b.data.order)
        .map(async (dv) => ({
          dv,
          teams: await Promise.all(
            franchises
              .filter((f) => f.data.division?.id === dv.id && f.data.status === 'active')
              .sort((a, b) => a.data.name.localeCompare(b.data.name))
              .map(async (f) => ({ f, city: await cityOf(f.id) })),
          ),
        })),
    ),
  })),
);
const historical = franchises.filter((f) => f.data.status === 'historical');
const activeCount = franchises.filter((f) => f.data.status === 'active').length;
const champs = (await getCollection('championships', (c) => c.data.league.id === league.id && c.data.level === 'league' && Boolean(c.data.verified)))
  .sort((a, b) => b.data.season.localeCompare(a.data.season));
const nameOf = new Map(franchises.map((f) => [f.id, f.data.name]));
const titleCounts = [...champs.reduce((m, c) => (c.data.winner ? m.set(c.data.winner.id, (m.get(c.data.winner.id) ?? 0) + 1) : m), new Map<string, number>())]
  .sort((a, b) => b[1] - a[1] || (nameOf.get(a[0]) ?? '').localeCompare(nameOf.get(b[0]) ?? ''));
const champSources = [...new Map(champs.flatMap((c) => c.data.sources).map((x) => [x.url, x])).values()];
const body = await prose('leagues', league.id, 'body');
const Body = body ? (await render(body)).Content : undefined;
---

<Base title={`${d.name} (${d.shortName})`} description={d.summary}>
  <EntityHeader
    eyebrow={`League · ${sport?.data.name} · ${d.country}`}
    title={d.shortName}
    intro={`${d.name}. ${d.summary}`}
    crumbs={[{ label: 'Home', href: '/' }, { label: d.shortName }]}
  />
  <div class="container section">
    {Body && <div class="prose"><Body components={{ Term }} /></div>}
    <p class="subtle">{activeCount} active franchises in this encyclopedia, counted from the data.</p>
  </div>
  <div class="container section">
    <div class="confs">
      {structure.map(({ c, divisions }) => (
        <section aria-labelledby={`c-${c.id}`}>
          <h2 id={`c-${c.id}`}>{c.data.name}</h2>
          {divisions.map(({ dv, teams }) => (
            <div class="division">
              <h3>{dv.data.name}</h3>
              <ul>
                {teams.map(({ f, city }) => (
                  <li class:list={[{ stub: f.data.progress === 'not-started' }]}>
                    <a href={routes.franchises(f.id)}>
                      <Logo logo={f.data.logo} name={f.data.name} size={36} color="#243045" />
                      <span>
                        <strong>{f.data.name}</strong>
                        <span class="subtle">{city?.data.name}{f.data.progress === 'not-started' ? ' · coming soon' : ''}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </div>
    {historical.length > 0 && (
      <section class="mt">
        <h2>Former franchises</h2>
        <ul>{historical.map((f) => <li><a href={routes.franchises(f.id)}>{f.data.name}</a></li>)}</ul>
      </section>
    )}
  </div>
  {champs.length > 0 && (
    <section class="container section" aria-labelledby="champions-title">
      <div class="section-head"><h2 id="champions-title">Every {d.shortName} champion</h2></div>
      <div class="champ-layout">
        <div>
          <h3>Most titles</h3>
          <ol class="leaders">
            {titleCounts.map(([id, n]) => (
              <li><a href={routes.franchises(id)}>{nameOf.get(id)}</a> <span class="subtle">{n}</span></li>
            ))}
          </ol>
          <p class="subtle small">Counted by today's franchise. Clubs that no longer exist are not in this list.</p>
        </div>
        <div class="table-wrap">
          <table class="champs">
            <caption class="sr-only">{d.shortName} Finals results by season</caption>
            <thead><tr><th scope="col">Season</th><th scope="col">Champion</th><th scope="col">Runner-up</th><th scope="col">Series</th></tr></thead>
            <tbody>
              {champs.map((c) => (
                <tr>
                  <td>{c.data.season}</td>
                  <td>{c.data.winner ? <a href={routes.franchises(c.data.winner.id)}>{c.data.winnerName}</a> : c.data.winnerName}</td>
                  <td>{c.data.runnerUp ? <a href={routes.franchises(c.data.runnerUp.id)}>{c.data.runnerUpName}</a> : c.data.runnerUpName}</td>
                  <td>{c.data.result}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}
  <div class="container section"><SourceList sources={[...d.sources, ...champSources]} /></div>
</Base>

<style>
  .champ-layout {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 960px) {
    .champ-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
      align-items: start;
    }
  }
  .leaders {
    display: grid;
    gap: 0.25rem;
    padding-left: 1.4rem;
    list-style: decimal;
  }
  .leaders li a {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    text-decoration: underline;
  }
  .small {
    font-size: 0.8rem;
  }
  .table-wrap {
    overflow-x: auto;
    max-height: 40rem;
    overflow-y: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .champs {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .champs th,
  .champs td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
  }
  .champs th {
    position: sticky;
    top: 0;
    background: var(--bg-raised);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-subtle);
  }
  .confs {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 960px) {
    .confs {
      grid-template-columns: 1fr 1fr;
    }
  }
  .division {
    margin-top: 1.5rem;
  }
  .division h3 {
    font-size: var(--step-2);
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }
  li a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text);
    text-decoration: none;
  }
  li a:hover {
    border-color: var(--accent);
  }
  li a > span {
    display: grid;
  }
  li.stub a {
    opacity: 0.7;
  }
  .mt {
    margin-top: 2.5rem;
  }
</style>
