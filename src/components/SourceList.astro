---
/** Sources and image credits, at the bottom of every entity page. */
import { formatDate, hostname } from '../lib/facts';

interface Credit {
  author: string;
  license: string;
  licenseUrl: string | null;
  page: string;
  caption?: string;
  alt: string;
}
interface Props {
  sources: { title: string; url: string; accessed: string }[];
  credits?: (Credit | undefined)[];
}
const { sources, credits = [] } = Astro.props;
const images = credits.filter((c): c is Credit => Boolean(c));
---

<section class="sources" aria-labelledby="sources-title">
  <h2 id="sources-title">Sources &amp; image credits</h2>
  <ol>
    {
      sources.map((s) => (
        <li>
          <a href={s.url} rel="noopener" target="_blank">
            {s.title}
          </a>
          <span class="subtle">
            {' '}
            · {hostname(s.url)} · accessed {formatDate(s.accessed)}
          </span>
        </li>
      ))
    }
  </ol>
  {
    images.length > 0 && (
      <>
        <h3>Photos</h3>
        <ul>
          {images.map((c) => (
            <li>
              {c.caption ?? c.alt}: {c.author},{' '}
              {c.licenseUrl ? (
                <a href={c.licenseUrl} rel="noopener license" target="_blank">
                  {c.license}
                </a>
              ) : (
                c.license
              )}
              , via{' '}
              <a href={c.page} rel="noopener" target="_blank">
                Wikimedia Commons
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>

<style>
  .sources {
    font-size: var(--step--1);
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }
  h2 {
    font-size: var(--step-3);
    margin-bottom: 1rem;
  }
  h3 {
    font-size: var(--step-1);
    margin: 1.25rem 0 0.5rem;
    text-transform: uppercase;
  }
  ol,
  ul {
    padding-left: 1.2rem;
    margin: 0;
  }
  li {
    margin-bottom: 0.35rem;
  }
</style>
