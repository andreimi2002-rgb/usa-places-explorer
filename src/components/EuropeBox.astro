---
/**
 * "For European fans": the practical, Europe-specific angle (time zones, European players,
 * games played in Europe), kept apart so the main text stays general.
 * Content comes from the entity's europe.mdx prose section.
 */
interface Props {
  /** Heading id prefix, unique on the page. */
  id?: string;
}
const { id = 'europe' } = Astro.props;
---

<aside class="europe" aria-labelledby={`${id}-title`}>
  <div class="head">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M2.5 12h19M12 2.5c2.6 2.7 3.9 5.9 3.9 9.5s-1.3 6.8-3.9 9.5c-2.6-2.7-3.9-5.9-3.9-9.5s1.3-6.8 3.9-9.5z" fill="none" stroke="currentColor" stroke-width="1.6" />
    </svg>
    <h2 id={`${id}-title`}>For European fans</h2>
  </div>
  <div class="prose body"><slot /></div>
</aside>

<style>
  .europe {
    border: 1px solid var(--line-strong);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--surface), var(--bg-raised));
    padding: 1.5rem clamp(1.1rem, 3vw, 2rem);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent-strong);
    margin-bottom: 0.75rem;
  }
  h2 {
    font-size: var(--step-3);
    margin: 0;
    color: var(--text);
  }
  .body {
    max-width: none;
  }
  .body :global(h3) {
    font-size: var(--step-1);
    margin-top: 1.25rem;
  }
</style>
